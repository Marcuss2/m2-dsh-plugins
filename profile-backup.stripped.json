        " //#endregion",
        " //#region src/failover/client/index.ts",
        " /** Required services (cordis fiber inject). */",
        "+/* KIT PATCH (m2-dsh-plugins): the Typert faces remote.settings / remote.session",
        "+   only exist on dsh >= 0.1.2-alpha.1 kernels; on 0.1.1-rc.2 (desktop 0.3.6/0.3.8",
        "+   and system CLI) demanding them leaves this entry pending forever and every",
        "+   web boot reports \"1 entry did not activate\". Require only what rc.2 has and",
        "+   probe the optional faces in apply() below — same dual-kernel pattern",
        "+   dsh-better-reasoning-effort uses. */",
        " const inject = [",
        " \t\"slots\",",
        " \t\"locale\",",
        "-\t\"remote\",",
        "-\t\"remote.settings\",",
        "-\t\"remote.session\"",
        "+\t\"remote\"",
        " ];",
        " /**",
        " * Register the `failover` dictionaries and the General settings row.",
        "@@ -432,6 +436,10 @@ function apply(ctx) {",
        " \t\ten",
        " \t}), \"llm-failover: dictionaries\");",
        " \tsetupMobileLayout(ctx);",
        "+\t/* KIT PATCH: skip the failover General-settings row when the alpha-kernel",
        "+\t   settings/session wires are absent (rc.2) — its callbacks would throw on",
        "+\t   an undefined ctx.remote.settings / ctx.remote.session. */",
        "+\tif (!ctx.remote.settings || !ctx.remote.session) return;",
        " \tctx.slots.inject(\"settings.general.item\", function* () {",
        " \t\tyield ctx.slots.register({",
        " \t\t\tname: \"settings.general.item\","
